# ============================================================
# GOLDENFARM ICT - Environment Configuration
# ============================================================
# Khi chuyển sang VPS mới: sửa IP ở 3 dòng có đánh dấu <<<,
# các dòng còn lại giữ nguyên.
# ============================================================

# ─── Server IP / Domain ───────────────────────────────────
VPS_IP=10.0.0.9
FRONTEND_PORT=8088
BACKEND_PORT=8000
ONLYOFFICE_PORT=8080
POSTGRES_PORT=5432

# ─── PostgreSQL Database ──────────────────────────────────
POSTGRES_USER=goldenfarm
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=goldenfarmict

# ─── Application ──────────────────────────────────────────
APP_ENV=production

# ─── CORS ─────────────────────────────────────────────────
# Danh sách origin được phép (cách nhau bằng dấu phẩy)
# <<< SỬA IP Ở ĐÂY >>>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://10.0.0.9:8088

# ─── OnlyOffice Document Server ──────────────────────────
BACKEND_PUBLIC_URL=http://backend:8000
ONLYOFFICE_URL=http://onlyoffice:80
# <<< SỬA IP Ở ĐÂY >>>
ONLYOFFICE_PUBLIC_URL=http://10.0.0.9:8080
ONLYOFFICE_SECRET=MySuperSecret123456
ONLYOFFICE_ENABLED=true
