# ─── Cấu hình Database (PostgreSQL) ────────────────────────────
# PostgreSQL là database duy nhất được hỗ trợ từ phiên bản 2.0 trở đi.

# Default configuration - use with Docker
# DATABASE_URL=postgresql://goldenfarm:your_strong_password@db:5432/goldenfarmict

# Local development (nếu chạy backend trên PC với PostgreSQL):
# DATABASE_URL=postgresql://goldenfarm:your_password@localhost:5432/goldenfarmict

# Lưu ý: SQLite support đã bị loại bỏ từ phiên bản 2.0 trở đi.
# Nếu không có PostgreSQL, backend sẽ không khởi động được.
# Hãy chạy docker compose để start PostgreSQL container.

# ─── Cấu hình OnlyOffice Document Server ───────────────────────
# OnlyOffice Document Server URL để xem/chỉnh sửa file Office (docx, xlsx, pptx, pdf)
# 
# Cấu hình cho OnlyOffice chạy trong Docker Compose:
# - Backend kết nối qua internal network: http://onlyoffice:80
# - Browser load JS từ: http://10.0.0.9:8080 (exposed port)
# - OnlyOffice callback URL: http://backend:8000 (internal network để download file)
#
# QUAN TRỌNG: BACKEND_PUBLIC_URL phải là URL mà OnlyOffice container có thể truy cập
# - Dùng hostname: http://backend:8000 (internal Docker network)
# - KHÔNG dùng: http://10.0.0.9:8088 (frontend nginx, OnlyOffice không thấy được)
BACKEND_PUBLIC_URL=http://backend:8000
ONLYOFFICE_URL=http://onlyoffice:80
ONLYOFFICE_PUBLIC_URL=http://10.0.0.9:8080
ONLYOFFICE_SECRET=MySuperSecret123456
ONLYOFFICE_ENABLED=true