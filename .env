# ============================================================
# GOLDENFARM ICT - Environment Configuration (HTTPS via NPM)
# ============================================================

# ─── Server IP / Domain ───────────────────────────────────
VPS_IP=10.0.0.114
FRONTEND_PORT=8088
BACKEND_PORT=8000
ONLYOFFICE_PORT=8090
POSTGRES_PORT=5432

# ─── PostgreSQL Database ──────────────────────────────────
POSTGRES_USER=goldenfarm
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=goldenfarmict

# ─── Application ──────────────────────────────────────────
APP_ENV=production

# ─── CORS ─────────────────────────────────────────────────
# Cho phép Domain public + Local dev
CORS_ORIGINS=https://noibo.canhdongvang.vn,http://localhost:5173,http://127.0.0.1:5173

# ─── OnlyOffice Document Server ──────────────────────────
BACKEND_PUBLIC_URL=http://backend:8000
ONLYOFFICE_URL=http://onlyoffice:80

# Trỏ public URL về subpath qua NPM (hoặc subdomain nếu bạn tách riêng)
ONLYOFFICE_PUBLIC_URL=https://noibo.canhdongvang.vn/onlyoffice
ONLYOFFICE_SECRET=MySuperSecret123456
ONLYOFFICE_ENABLED=true

# ─── Draw.io (Diagrams.net) ─────────────────────────────────
DRAWIO_PORT=8091
DRAWIO_PUBLIC_URL=https://noibo.canhdongvang.vn/drawio
VITE_DRAWIO_PUBLIC_URL=https://noibo.canhdongvang.vn/drawio